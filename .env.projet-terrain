# ------------------------------------------------------------------------------
# 1. Base de données PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_DB=materiel_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. Adminer (Interface web BDD)
# ------------------------------------------------------------------------------
ADMINER_PORT=8081
ADMINER_DEFAULT_SERVER=postgres

# ------------------------------------------------------------------------------
# 3. Backend Spring Boot (Java 21) - Images Projet Terrain
# ------------------------------------------------------------------------------
BACKEND_PORT=8080
BACKEND_IMAGE=ghcr.io/wd12g4/projet-terrain-backend:latest
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/materiel_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
JWT_SECRET=uneSuperCleSecreteTresLonguePourLeDevDeMonApplication2026!

# ------------------------------------------------------------------------------
# 4. Frontend Vue.js (Vite + Nginx) - Images Projet Terrain
# ------------------------------------------------------------------------------
FRONTEND_PORT=80
# HTTPS de la PWA (iPhone) : actif si materiel-terrain/certs contient server.crt et server.key
FRONTEND_HTTPS_PORT=443
FRONTEND_IMAGE=ghcr.io/wd12g4/projet-terrain-frontend:latest
