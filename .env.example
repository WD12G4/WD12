# ------------------------------------------------------------------------------
# 1. Base de données PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_DB=materiel_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. Adminer (Interface web BDD)
# ------------------------------------------------------------------------------
# 8082 est souvent déjà pris sur la VM
ADMINER_PORT=8082
ADMINER_DEFAULT_SERVER=postgres

# ------------------------------------------------------------------------------
# 3. Backend Spring Boot (Java 21)
# ------------------------------------------------------------------------------
# 8080 est déjà pris sur la VM. Nginx joint toujours le backend par le réseau Docker (backend:8080).
BACKEND_PORT=8090
# Image Docker du backend (pour docker compose pull / CD)
BACKEND_IMAGE=ghcr.io/wd12g4/wd12-backend:latest
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/materiel_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Keycloak vu par le backend : jetons émis pour KEYCLOAK_URL, clés lues par le réseau Docker
KEYCLOAK_JWKS_URI=http://keycloak:8080/auth/realms/gestion-parc/protocol/openid-connect/certs

# Secret partagé pour l'authentification des agents de supervision WebSocket (X-Agent-Secret)
AGENT_SECRET=wd12-supervision-secret-change-in-prod

# ------------------------------------------------------------------------------
# 4. Frontend Vue.js (Vite + Nginx HTTPS)
# ------------------------------------------------------------------------------
FRONTEND_PORT=80
# HTTPS (le port 80 redirige vers celui-ci)
FRONTEND_HTTPS_PORT=443
FRONTEND_IMAGE=ghcr.io/wd12g4/wd12-frontend:latest

# ------------------------------------------------------------------------------
# 5. Keycloak (fournisseur d'identité, joue MinDef Connect)
# ------------------------------------------------------------------------------
# Keycloak est servi par le Nginx du front sous /auth, en HTTPS (même adresse que l'application).
# Adresse de l'application vue par le NAVIGATEUR : celle de la VM (en local : https://localhost).
# Le certificat HTTPS auto-signé est créé pour cette adresse (volume certs_data).
APP_URL=https://172.16.131.130
# Adresse de Keycloak vue par le NAVIGATEUR : APP_URL suivie de /auth.
# Elle doit être identique pour Keycloak (émetteur des jetons) et le backend (vérification).
# Après un changement : docker compose rm -sf keycloak && docker compose up -d keycloak backend frontend
KEYCLOAK_URL=https://172.16.131.130/auth
# Accès direct à Keycloak (serveur de développement Vite, dépannage)
KEYCLOAK_PORT=8180
# Compte de la console d'administration de Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
